class TitanEmbeddedWebServer:
    def __init__(self, settings, state_store, risk_manager):
        self.settings = settings
        self.state_store = state_store
        self.risk_manager = risk_manager
        self.app = FastAPI(title="TITAN v15.12.3 Enterprise Dashboard")
        self.setup_routes()

    def setup_routes(self):
        @self.app.get("/", response_class=HTMLResponse)
        async def dashboard_home():
            return HTML_DASHBOARD_TEMPLATE

        @self.app.get("/api/status")
        async def api_status():
            return {
                "status": "healthy",
                "version": "15.12.3",
                "engine": "running"
            }

    async def start(self):
        config = uvicorn.Config(self.app, host="127.0.0.1", port=8000, log_level="warning")
        server = uvicorn.Server(config)
        logger.info("Starting embedded Web Dashboard server on http://127.0.0.1:8000 ...")
        await server.serve()

    async def stop(self):
        logger.info("Stopping Web Dashboard server...")


class TitanFullProductionSystem:
    """
    TITAN v15.12.3 Arşivinin Web Paneli Dahil Tam ve Eksiksiz Entegrasyon Sınıfı[span_6](start_span)[span_6](end_span).
    """
    def __init__(self):
        logger.info("Initializing configuration parameters via load_settings()...")
        self.settings = load_settings()
        
        logger.info("Initializing State Store and Persistence Layer...")
        self.state_store = StateStore()
        
        logger.info("Initializing Risk Management Subsystem...")
        self.risk_manager = RiskManager(self.settings)
        
        logger.info("Initializing Binance Exchange Client...")
        self.binance_client = BinanceClient(self.settings)
        
        logger.info("Initializing Execution & Order Manager...")
        self.order_manager = OrderManager(self.binance_client, self.state_store)
        
        logger.info("Initializing Market Data Feed Subsystem...")
        self.market_feed = MarketFeed(self.settings)
        
        logger.info("Initializing Strategy Matrix (ActiveStrategy)...")
        self.strategy = ActiveStrategy(self.settings)
        
        logger.info("Initializing State Reconciliation Engine...")
        self.reconciliation = StateReconciliation(self.binance_client, self.state_store)
        
        logger.info("Initializing Private WebSocket Manager for Real-Time Execution Streams...")
        self.private_ws = PrivateWebSocketManager(self.settings, self.state_store)
        
        logger.info("Initializing Embedded Web Dashboard Server...")
        self.dashboard_server = TitanEmbeddedWebServer(self.settings, self.state_store, self.risk_manager)
        
        logger.info("Binding all components into the core TradingEngine...")
        self.engine = TradingEngine(
            feed=self.market_feed,
            strategy=self.strategy,
            risk_manager=self.risk_manager,
            order_manager=self.order_manager,
            state_store=self.state_store
        )
        
        self.is_running = False

    async def preflight_checks(self) -> bool:
        logger.info("Running preflight validation checks...")
        try:
            ping_status = await self.binance_client.ping()
            if ping_status is False:
                logger.error("Preflight failed: Binance exchange endpoint is unreachable.")
                return False
            logger.info("Preflight checks passed successfully.")
            return True
        except Exception as e:
            logger.critical(f"Critical error during preflight checks: {e}", exc_info=True)
            return False

    async def initialize_system(self):
        logger.info("Starting full system initialization sequence...")
        if not await self.preflight_checks():
            raise RuntimeError("System preflight checks failed. Aborting startup.")

        logger.info("Executing State Reconciliation with exchange records...")
        await self.reconciliation.run_full_sync()

        logger.info("Establishing Private WebSocket connection...")
        await self.private_ws.connect()

        logger.info("Subscribing to active market data feeds...")
        await self.market_feed.subscribe_symbols()

        logger.info("All internal archive modules successfully synchronized.")

    async def start(self):
        self.is_running = True
        try:
            await self.initialize_system()
            logger.info("TITAN v15.12.3 Engine loop and Web Server are starting concurrently...")
            
            # Ticaret motoru ile web arayüzünü aynı anda çalıştırır
            await asyncio.gather(
                self.engine.run(),
                self.dashboard_server.start()
            )
        except asyncio.CancelledError:
            logger.warning("Engine or Web tasks were cancelled.")
        except Exception as e:
            logger.critical(f"Unhandled exception in TITAN production core: {e}", exc_info=True)
            raise
        finally:
            await self.shutdown()

    async def shutdown(self):
        if not self.is_running:
            return
        
        logger.info("Initiating graceful shutdown sequence for TITAN system...")
        self.is_running = False
        
        try:
            await self.dashboard_server.stop()
        except Exception as e:
            logger.error(f"Error stopping dashboard server: {e}")

        try:
            if hasattr(self.private_ws, "close"):
                await self.private_ws.close()
        except Exception as e:
            logger.error(f"Error closing private websocket: {e}")

        try:
            if hasattr(self.market_feed, "stop"):
                await self.market_feed.stop()
        except Exception as e:
            logger.error(f"Error stopping market feed: {e}")

        logger.info("TITAN system shutdown complete. All states persisted.")


if __name__ == "__main__":
    system = TitanFullProductionSystem()
    try:
        asyncio.run(system.start())
    except KeyboardInterrupt:
        logger.info("Received KeyboardInterrupt. Shutting down TITAN gracefully...")
    except Exception as fatal_error:
        logger.critical(f"Fatal startup error: {fatal_error}", exc_info=True)
        sys.exit(1)
