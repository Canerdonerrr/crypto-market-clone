import sys
from typing import Any
if sys.version_info >= (3, 14):
    try:
        import pydantic.fields
        original_prepare = pydantic.fields.ModelField.prepare
        def patched_prepare(self):
            if getattr(self, 'type_', None) is None:
                self.type_ = Any
            try:
                original_prepare(self)
            except Exception:
                self.type_ = Any
        pydantic.fields.ModelField.prepare = patched_prepare
    except Exception:
        pass

