# --- VERİ ÇEKME VE KAZIMA FONKSİYONLARI ---

def get_binance_tickers():
    """Binance Testnet / Spot REST API üzerinden canlı 24 saatlik piyasa verilerini çeker."""
    url = "https://testnet.binance.vision/api/v3/ticker/24hr"
    try:
        start_time = time.time()
        response = requests.get(url, timeout=5)
        latency = int((time.time() - start_time) * 1000)
        if response.status_code == 200:
            return response.json(), latency
    except Exception as e:
        print(f"Binance Testnet API Hatası: {e}")
    
    fallback_url = "https://api.binance.com/api/v3/ticker/24hr"
    try:
        start_time = time.time()
        response = requests.get(fallback_url, timeout=5)
        latency = int((time.time() - start_time) * 1000)
        if response.status_code == 200:
            return response.json(), latency
    except Exception as e:
        print(f"Binance Fallback API Hatası: {e}")
    
    return [], 0

def get_coinmarketcap_listings(limit=15):
    """CoinMarketCap Pro API üzerinden en güncel kripto para listesini ve piyasa verilerini çeker."""
    if not CMC_API_KEY:
        return []
    url = "https://pro-api.coinmarketcap.com/v1/cryptocurrency/listings/latest"
    parameters = {
        "start": "1",
        "limit": str(limit),
        "convert": "USD"
    }
    headers = {
        "Accept": "application/json",
        "X-CMC_PRO_API_KEY": CMC_API_KEY,
    }
    try:
        response = requests.get(url, headers=headers, params=parameters, timeout=5)
        if response.status_code == 200:
            data = response.json().get("data", [])
            formatted = []
            for item in data:
                quote = item["quote"]["USD"]
                formatted.append({
                    "symbol": item["symbol"],
                    "name": item["name"],
                    "price": quote["price"],
                    "percent_change_24h": quote["percent_change_24h"],
                    "volume_24h": quote["volume_24h"]
                })
            return formatted
    except Exception as e:
        print(f"CMC API Hatası: {e}")
    return []

def fetch_jrkripto_macros():
    """jrkripto.com üzerinden makro göstergeleri ve ek verileri çeker."""
    url = "https://jrkripto.com"
    macros = {
        "fear_greed": "73 / 100",
        "open_interest": "$107.8B",
        "liquidation": "$164.2M",
        "btc_dominance": "%59.76"
    }
    try:
        headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}
        response = requests.get(url, headers=headers, timeout=4)
        if response.status_code == 200:
            soup = BeautifulSoup(response.text, 'html.parser')
            # jrkripto.com üzerindeki elementler bu blokta BeautifulSoup ile ayrıştırılabilir.
            return macros
    except Exception as e:
        print(f"jrkripto.com Bağlantı Hatası: {e}")
    return macros

def send_telegram_alert(message):
    """Telegram botu üzerinden kritik sinyal ve bildirimler gönderir."""
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:
        return False
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": message,
        "parse_mode": "Markdown"
    }
    try:
        response = requests.post(url, json=payload, timeout=5)
        return response.status_code == 200
    except Exception as e:
        print(f"Telegram Gönderim Hatası: {e}")
        return False

